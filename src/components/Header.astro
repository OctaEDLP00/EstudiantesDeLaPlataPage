---
import Edlp from '~/assets/edlp.svg'
import Hamburger from '~/assets/hamburger.svg'
import Button from '~/components/ui/Button.astro'

interface Props {
  variant?: 'full' | 'minimal'
}

const { variant = 'full' } = Astro.props

const LINKS = [
  { label: 'Inicio', href: '/' },
  { label: 'Eventos', href: '/eventos' },
  { label: 'Mi usuario', href: '/usuario' },
  { label: 'Autogestión', href: '/autogestion' },
  { label: 'Abonos', href: '/abonos' },
  { label: 'Beneficios', href: '/promociones' },
]

const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

<header class='border-edlp-black/10 bg-edlp-cream/95 sticky top-0 z-50 border-b backdrop-blur-md'>
  {
    variant === 'minimal' ?
      <div class='mx-auto flex h-23 max-w-350 items-center justify-center px-4 md:h-30'>
        <a
          href='/'
          class='transition-transform duration-300 hover:scale-105'
          aria-label='Estudiantes de La Plata - Inicio'
        >
          <Edlp
            class='h-16 w-auto md:h-24'
            aria-hidden='true'
            focusable='false'
          />
        </a>
      </div>
    : <div class='mx-auto flex h-21 max-w-350 items-center justify-between gap-4 px-4 md:h-26 md:px-8'>
        <nav
          aria-label='Secciones del portal'
          class='hidden flex-1 items-center gap-6 lg:flex'
        >
          {LINKS.map(({ label, href }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'hover:text-edlp-red-700 relative py-2 text-[13px] font-bold tracking-[0.03em] uppercase transition-colors',
                isActive(href) &&
                  'text-edlp-black after:bg-edlp-red after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>

        <details class='group relative flex-1 lg:hidden'>
          <summary
            class='text-edlp-black inline-flex cursor-pointer list-none items-center justify-center p-1.5 [&::-webkit-details-marker]:hidden'
            aria-label='Abrir menú'
          >
            <Hamburger
              class='size-6'
              aria-hidden='true'
              focusable='false'
            />
          </summary>
          <nav
            aria-label='Secciones del portal'
            class='bg-edlp-card text-edlp-ink clip-corner absolute top-[calc(100%+12px)] left-0 z-50 flex w-64 flex-col overflow-hidden shadow-2xl'
          >
            {LINKS.map(({ label, href }) => (
              <a
                href={href}
                class:list={[
                  'hover:bg-edlp-red border-b border-white/5 px-5 py-4 text-sm font-bold tracking-wide uppercase transition-colors hover:text-white',
                  isActive(href) && 'text-edlp-red-300',
                ]}
              >
                {label}
              </a>
            ))}
          </nav>
        </details>

        <a
          href='/'
          class='shrink-0 transition-transform duration-300 hover:scale-105'
          aria-label='Estudiantes de La Plata - Inicio'
        >
          <Edlp
            class='h-14 w-auto md:h-18'
            aria-hidden='true'
            focusable='false'
          />
        </a>

        <div class='flex flex-1 items-center justify-end gap-3 md:gap-5'>
          <span class='text-edlp-black/60 hidden font-mono text-[11px] tracking-[0.12em] uppercase md:inline'>
            Hola, Octavio
          </span>
          <Button
            href='/login'
            variant='ghost'
            size='sm'
          >
            Salir
          </Button>
        </div>
      </div>
  }
</header>
