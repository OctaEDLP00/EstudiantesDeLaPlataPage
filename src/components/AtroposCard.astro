---
import 'atropos/css'

interface Props {
  atroposClass?: string
  atroposInnerClass?: string
  atroposScaleClass?: string
  atroposRotateClass?: string
  id?: string
}

const { atroposClass, atroposInnerClass, atroposScaleClass, atroposRotateClass, id } = Astro.props
---

<div
  id={id}
  data-component='AtroposCard'
  class:list={['atropos my-atropos', atroposClass]}
>
  <div class:list={['atropos-scale', atroposScaleClass]}>
    <div class:list={['atropos-rotate', atroposRotateClass]}>
      <div class:list={['atropos-inner rounded-lg', atroposInnerClass]}>
        <slot />
      </div>
    </div>
  </div>
</div>

<script>
  // import Atropos library
  import Atropos from 'atropos'

  // Initialize
  Atropos({
    el: '.my-atropos',
  })
</script>
