import Edlp from '~/assets/edlp.svg'
import WhatsApp from '~/components/WhatsApp.astro'

interface Info {
  city: string
  name: string
  street: string
  phone: string
  place: string
}

const INFO_FOOTER = [
  {
    place: 'sede social',
    name: 'pedro j. osácar',
    street: 'av. 53 Nº 620 (1900)',
    phone: '(+54 221) 527 7107',
    city: 'la plata',
  },
  {
    place: 'country club',
    name: 'mariano mangano',
    street: 'calle 462 (alvear) esq. 28',
    phone: '(+54 221) 527 7106',
    city: 'city bell',
  },
  {
    place: 'estadio',
    name: 'jorge luis hirschi',
    street: 'av. 1 e/ 55 y 57',
    phone: '(+54 221) 527 7100',
    city: 'la plata',
  },
  {
