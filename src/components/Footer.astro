      {INFO_FOOTER.map(props => <CardInfo {...props} />)}
    </section>
    <section class='m-auto'>
      <p>© 2025 Todos los derechos reservados.</p>
    </section>
  </div>
  <WhatsApp phone='+5492215217100' />
