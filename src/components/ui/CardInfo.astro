---
interface Props {
  city: string
  name: string
  street: string
  phone: string
  place: string
}

const { place, phone, street, name, city } = Astro.props
---

<article class='flex flex-col gap-1.5'>
  <h3 class='text-xs leading-tight font-extrabold tracking-[0.08em] text-white uppercase'>
    {place}
    <span class='block'>{name}</span>
  </h3>
  <p class='text-edlp-ink/70 font-mono text-[11px] leading-relaxed'>{street}</p>
  <p class='text-edlp-ink/70 font-mono text-[11px]'>{city} - Buenos Aires</p>
  <a
    href={`tel:${phone}`}
    class='text-edlp-ink/70 hover:text-edlp-red-300 font-mono text-[11px] transition-colors'
  >
    {phone}
  </a>
</article>
