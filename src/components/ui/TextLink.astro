---
import Link from './Link.astro'
import ArrowRight from '~/assets/arrow-right.svg'

interface Props {
  title: string
  description?: string
  to: string
  class: string
  asBlank?: boolean
}

const { title, description, to } = Astro.props
---

<Link
  {to}
  class:list={['flex flex-col rounded-xl border p-3', Astro.props.class]}
>
  <div class='flex-1 uppercase'>
    <h2 class='text-2xl font-semibold'>{title}</h2>
    {description && <p class='text-xs font-normal'>{description}</p>}
  </div>
  <ArrowRight class='size-7 self-end' />
</Link>
