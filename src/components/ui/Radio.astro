---
import FieldLabel from './FieldLabel.astro'

interface Props {
  name: string
  legend?: string
  class?: string
}

const { name, legend, class: className } = Astro.props
---

<fieldset class:list={['flex flex-wrap items-center gap-5', className]}>
  {
    legend && (
      <FieldLabel
        as='legend'
        class='mr-2'
      >
        {legend}
      </FieldLabel>
    )
  }
  <label class='text-edlp-ink flex cursor-pointer items-center gap-2 text-sm'>
    <input
      type='radio'
      name={name}
      value='si'
      class='accent-edlp-red size-4'
    />
    SI
  </label>
  <label class='text-edlp-ink flex cursor-pointer items-center gap-2 text-sm'>
    <input
      type='radio'
      name={name}
      value='no'
      class='accent-edlp-red size-4'
    />
    NO
  </label>
</fieldset>
