---
import ArrowRight from '~/assets/arrow-right.svg'
import AccentBar from './AccentBar.astro'

interface Props {
  title: string
  description?: string
  href?: string
  image?: string
  tag?: string
  meta?: string
  asBlank?: boolean
  headingLevel?: 'h2' | 'h3'
  class?: string
}

const {
  title,
  description,
  href,
  image,
  tag,
  meta,
  asBlank,
  headingLevel: Heading = 'h3',
  class: className,
} = Astro.props

const Tag = href ? 'a' : 'div'
const linkProps =
  href ?
    {
      href,
      target: asBlank ? '_blank' : '_self',
      rel: asBlank ? 'noopener noreferrer' : undefined,
    }
  : {}
---

<Tag
  {...linkProps}
  class:list={[
    'group bg-edlp-card text-edlp-ink clip-corner relative flex flex-col overflow-hidden transition-colors duration-300',
    href && 'hover:bg-edlp-black',
    className,
  ]}
>
  {
    image && (
      <div class='bg-edlp-black relative aspect-768/512 w-full overflow-hidden'>
        <img
          src={image}
          alt={title}
          loading='lazy'
          class='size-full object-cover transition-transform duration-500 group-hover:scale-105'
        />
        <span class='bg-edlp-red/0 group-hover:bg-edlp-red/25 absolute inset-0 transition-colors duration-300' />
      </div>
    )
  }

  <div class='relative flex flex-1 flex-col gap-2 p-5'>
    <AccentBar side='top' />
    {
      tag && (
        <span class='text-edlp-red-300 font-mono text-[11px] font-medium tracking-[0.18em] uppercase'>
          {tag}
        </span>
      )
    }
    <Heading class='font-display text-lg leading-tight uppercase'>{title}</Heading>
    {description && <p class='text-edlp-ink/65 text-sm leading-relaxed'>{description}</p>}
    {
      meta && (
        <span class='text-edlp-ink/60 font-mono text-[11px] tracking-widest uppercase'>{meta}</span>
      )
    }

    <div class='mt-auto flex items-center justify-between pt-4'>
      <slot />
      {
        href && (
          <span class='group-hover:text-edlp-red-300 inline-flex items-center gap-2 text-xs font-black tracking-[0.12em] uppercase transition-colors'>
            Ver más
            <ArrowRight
              class='size-4 transition-transform duration-300 group-hover:translate-x-1'
              aria-hidden='true'
              focusable='false'
            />
          </span>
        )
      }
    </div>
  </div>
</Tag>
