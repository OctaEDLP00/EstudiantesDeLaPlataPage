---
import type { HTMLAttributes } from 'astro/types'
import FieldLabel from './FieldLabel.astro'

interface Props extends HTMLAttributes<'input'> {
  labelText: string
  containerClass?: string
  inputClass?: string
  forLabel: string
}

const { labelText, forLabel, containerClass, inputClass, class: className, ...props } = Astro.props
---

<div class={containerClass}>
  <FieldLabel
    for={forLabel}
    class='mb-2 block'
  >
    {labelText}
  </FieldLabel>
  <input
    id={forLabel}
    name={forLabel}
    autocomplete='off'
    class:list={[
      'text-edlp-ink placeholder:text-edlp-ink/30 focus:border-edlp-red w-full border border-white/15 bg-white/5 px-4 py-3 text-sm transition-colors focus:outline-none',
      inputClass,
      className,
    ]}
    {...props}
  />
</div>
