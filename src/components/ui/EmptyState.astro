---
interface Props {
  title: string
  description?: string
  class?: string
}

const { title, description, class: className } = Astro.props
---

<section
  class:list={[
    'bg-edlp-card text-edlp-ink clip-corner flex flex-col items-center gap-3 px-6 py-16 text-center',
    className,
  ]}
>
  <p class='font-display text-lg uppercase'>{title}</p>
  {
    description && (
      <p class='text-edlp-ink/55 font-mono text-[11px] tracking-[0.15em] uppercase'>
        {description}
      </p>
    )
  }
</section>
