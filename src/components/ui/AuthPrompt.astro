---
interface Props {
  text: string
  linkText: string
  href: string
  class?: string
}

const { text, linkText, href, class: className } = Astro.props
---

<p class:list={['text-edlp-ink/70 text-center text-sm', className]}>
  {text}{' '}
  <a
    href={href}
    class='text-edlp-red-300 font-bold hover:underline'
  >
    {linkText}
  </a>
</p>
