---
import type { Partner } from '~/types/index.d.ts'
import Header from './carnet-sections/Header.astro'
import Footer from './carnet-sections/Footer.astro'
import Qr from '~/components/Qr.astro'

type Props = { partner?: Partner }
const { partner } = Astro.props
---

<div
  data-component='Carnet'
  class='grid h-full gap-4 md:grid-cols-5 md:grid-rows-5'
>
  <Header />
  <main class='col-span-5 row-span-3 row-start-2'>
    <div class='grid grid-cols-5 grid-rows-5 gap-4'>
      <div class='col-span-3 row-span-5'>
        <div class='flex flex-col items-start pl-6'>
          {
            partner ?
              <img
                alt={partner.fullName}
                src={partner.partnerImg}
                class='size-24'
              />
            : <img
                alt='Osvaldo Zubeldia'
                src='/img/osvaldo-zubeldia.jpeg'
                width='341'
                height='309'
                class='aspect-341/309 h-auto w-24'
              />
          }
          <div class='mt-3.5'>
            <h2 class='uppercase'>
              {partner?.lastName ?? 'Zubeldia'}, {partner?.name ?? 'Osvaldo'}
            </h2>
            <h3>Socio N°: {partner?.nroPartner ?? '16101968'}</h3>
          </div>
        </div>
      </div>
      <div class='col-span-2 col-start-4 row-span-5 flex items-center justify-center'>
        <div class='flex flex-col space-y-4'>
          <Qr
            class='size-30'
            data={String(partner?.dni ?? 12345678)}
            fgColor='#000000'
            bgColor='#fff0'
            margin={0}
            render
          />
          <p class='uppercase'>{partner?.partnerType ?? 'honorario'}</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</div>
